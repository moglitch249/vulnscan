# =============================================================================
# VulnScanner Configuration — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# =============================================================================

# --- NVD (National Vulnerability Database) ---
# Free API key: https://nvd.nist.gov/developers/request-an-api-key
# Without key: 5 req / 30s. With key: 50 req / 30s.
NVD_API_KEY=

# --- VulnCheck ---
# Free community tier: https://vulncheck.com/
# Community: 1000 req/min
VULNCHECK_API_KEY=

# --- GitHub (GHSA) ---
# Personal Access Token with public_repo scope
# https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Scanning ---
# Maximum concurrent tasks (scans, API queries)
MAX_CONCURRENCY=10

# --- Feature Toggles ---
EPSS_ENABLED=true
KEV_ENABLED=true
OSV_ENABLED=true
NVD_ENABLED=true
GHSA_ENABLED=true
VULNCHECK_ENABLED=true
EXPLOITDB_ENABLED=true

# --- Database ---
# SQLite path (relative to project root or absolute)
DATABASE_PATH=data/vulnscanner.db

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Network ---
# HTTP request timeout in seconds
HTTP_TIMEOUT=30
# Maximum retries for failed requests
MAX_RETRIES=3

# --- Offline Mode ---
# Path for offline vulnerability data cache
OFFLINE_DATA_PATH=data/offline
